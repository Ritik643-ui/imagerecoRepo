# Receipt Organizer Environment Variables
# Copy this file to .env and fill in your actual values

# Firebase Configuration
# Get these values from your Firebase project settings
EXPO_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your_project_id_here
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id_here
EXPO_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id_here

# Google Cloud Vision API
# Create an API key in Google Cloud Console with Vision API enabled
EXPO_PUBLIC_GOOGLE_CLOUD_VISION_API_KEY=your_google_cloud_vision_api_key_here

# Optional: Analytics Configuration
# EXPO_PUBLIC_ANALYTICS_ENABLED=true

# Optional: Debug Configuration
# EXPO_PUBLIC_DEBUG_MODE=false

# Development Notes:
# - Never commit the actual .env file to version control
# - Use EXPO_PUBLIC_ prefix for variables that need to be available in the client
# - Keep sensitive keys secure and rotate them regularly
# - Consider using different keys for development and production environments

